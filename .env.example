# NEXADOWN Server Configuration
PORT=3000
NODE_ENV=production

# CORS allowed origin (* for open public access, or specify domain like https://example.com)
CORS_ORIGIN=*

# Maximum simultaneous active extraction and conversion tasks
MAX_CONCURRENT_JOBS=4

# Temporary storage directory for in-flight media processing
TEMP_DIR=temp

# Rate Limiting (window in ms, max requests per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150

# Optional Render external URL for automated health ping keep-alive
# RENDER_EXTERNAL_URL=https://nexadown.onrender.com
